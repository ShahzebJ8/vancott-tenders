<?xml version="1.0" encoding="utf-8"?>
<!--
  Security: nothing this app stores is included in cloud backup or in a
  device-to-device transfer. Your shortlist, notes and assignments stay on the
  phone they were made on and never leave it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
